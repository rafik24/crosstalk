# Runtime / secrets — never commit
node_modules/
*.log

# Per-session harness state (OMC HUD cache etc.) — holds local paths + cost data.
.omc/

# The bus connection config holds CC_TOKEN — it lives in ~/.claude/.cross-claude-bus,
# NOT in this repo. Guard against it ever being copied in.
.cross-claude-bus

# Mothballed hand-rolled broker (superseded by the vendored server/) — do not track here.
# Anchored to the repo ROOT (leading /) so they do NOT match the vendored server/server.mjs etc.
/connect.mjs
/server.mjs
/index.html

# Scratch copies of the repo made by test/handover.test.mjs (two versions side by side).
.qa-scratch/
evals/results/*.json
evals/results/2026-*/
evals/results/bus-*.log
