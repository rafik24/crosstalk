{
  "openapi": "3.0.3",
  "info": {
    "title": "Crosstalk",
    "version": "3.0.0",
    "description": "REST API for the Crosstalk coordination bus: presence, channels, messages, shared data, and the work board. All /api routes require the bus bearer token (Authorization: Bearer <key> or ?api_key=<key>). While the leader is draining for a stepdown (see /cc/stepdown?drain=1) every non-GET /api request is refused with 503 {reason:\"draining\"} + Retry-After; reads keep working."
  },
  "servers": [{ "url": "/api" }],
  "security": [{ "bearerAuth": [] }, { "apiKeyQuery": [] }],
  "tags": [
    { "name": "presence" },
    { "name": "channels" },
    { "name": "messages" },
    { "name": "data" },
    { "name": "work" },
    { "name": "control-plane", "description": "Leader discovery, stepdown and replication — served at the root (/cc/*), not under /api, and not bearer-token routes." }
  ],
  "paths": {
    "/register": {
      "post": {
        "tags": ["presence"],
        "summary": "Register or refresh a session's presence",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["instance_id"],
                "properties": {
                  "instance_id": { "type": "string" },
                  "description": { "type": "string" },
                  "rev": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "instance_id": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/instances": {
      "get": {
        "tags": ["presence"],
        "summary": "List known sessions (stale ones are marked offline first)",
        "responses": {
          "200": {
            "description": "Instances",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "instances": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Instance" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/channels": {
      "get": {
        "tags": ["channels"],
        "summary": "List channels with activity",
        "responses": {
          "200": {
            "description": "Channels",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channels": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Channel" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["channels"],
        "summary": "Create a channel (name is normalized)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "channel": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/channels/search": {
      "get": {
        "tags": ["channels"],
        "summary": "Search channels by name/description",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "channels": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Channel" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/messages": {
      "post": {
        "tags": ["messages"],
        "summary": "Post a message (channel auto-created if new)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["sender", "content"],
                "properties": {
                  "channel": { "type": "string", "default": "general" },
                  "sender": { "type": "string" },
                  "content": { "type": "string" },
                  "message_type": {
                    "type": "string",
                    "enum": ["message", "request", "response", "status", "handoff", "done"],
                    "default": "message"
                  },
                  "in_reply_to": { "type": "integer" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Posted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "id": { "type": "integer" },
                    "channel": { "type": "string" },
                    "message_type": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/messages/{channel}": {
      "get": {
        "tags": ["messages"],
        "summary": "Read a channel (latest, since after_id, or unread for an instance)",
        "parameters": [
          { "name": "channel", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "after_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "instance_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    },
                    "last_id": { "type": "integer", "nullable": true }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/messages/{channel}/{id}/replies": {
      "get": {
        "tags": ["messages"],
        "summary": "Get a message and its replies",
        "parameters": [
          { "name": "channel", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Parent and replies",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "parent": { "$ref": "#/components/schemas/Message" },
                    "replies": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["messages"],
        "summary": "Full-text-ish search across message content",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": {
            "description": "Matches",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Message" }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/data": {
      "get": {
        "tags": ["data"],
        "summary": "List shared-data keys",
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/SharedDataSummary" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["data"],
        "summary": "Store (upsert) a shared-data value",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["key", "content", "sender"],
                "properties": {
                  "key": { "type": "string" },
                  "content": { "type": "string" },
                  "sender": { "type": "string" },
                  "description": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stored",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "key": { "type": "string" },
                    "size_bytes": { "type": "integer" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/data/{key}": {
      "get": {
        "tags": ["data"],
        "summary": "Fetch one shared-data value",
        "parameters": [
          { "name": "key", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Value",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SharedData" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/work": {
      "get": {
        "tags": ["work"],
        "summary": "List work items (epics grouped before their children)",
        "parameters": [
          { "name": "project", "in": "query", "schema": { "type": "string" } },
          { "name": "state", "in": "query", "schema": { "type": "string" } },
          { "name": "owner", "in": "query", "schema": { "type": "string" } },
          { "name": "parent_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "kind", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/WorkItem" }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["work"],
        "summary": "Create a work item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string" },
                  "project": { "type": "string", "default": "default" },
                  "external_ref": { "type": "string" },
                  "parent_id": { "type": "integer" },
                  "kind": { "type": "string", "enum": ["epic", "task", "bug"], "default": "task" },
                  "domain": { "type": "string" },
                  "owner": { "type": "string" },
                  "state": {
                    "type": "string",
                    "enum": ["queued", "claimed", "implementing", "in-review", "merged", "deployed", "blocked", "abandoned"],
                    "default": "queued"
                  },
                  "created_by": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/work/{id}": {
      "get": {
        "tags": ["work"],
        "summary": "Fetch one work item",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "item": { "$ref": "#/components/schemas/WorkItem" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/work/{id}/claim": {
      "post": {
        "tags": ["work"],
        "summary": "Atomically claim a work item (mutex)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["owner"],
                "properties": { "owner": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claimed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "Already claimed by another owner",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "example": "already claimed" },
                    "owner": { "type": "string" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/work/{id}/handoff": {
      "post": {
        "tags": ["work"],
        "summary": "Transfer or release ownership (empty owner = release)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "owner": { "type": "string", "nullable": true } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transferred",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/work/{id}/state": {
      "post": {
        "tags": ["work"],
        "summary": "Set a work item's state",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["state"],
                "properties": {
                  "state": {
                    "type": "string",
                    "enum": ["queued", "claimed", "implementing", "in-review", "merged", "deployed", "blocked", "abandoned"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "item": { "$ref": "#/components/schemas/WorkItem" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/Draining" }
        }
      }
    },
    "/cc/whoami": {
      "servers": [{ "url": "/" }],
      "get": {
        "tags": ["control-plane"],
        "summary": "Discovery beacon: who leads, where, and whether it is draining (public — never carries the token)",
        "security": [],
        "parameters": [
          { "name": "nonce", "in": "query", "required": false, "description": "16–64 hex chars. When given (and the bus has a token), the answer carries `proof`, an HMAC over the nonce and this leader's identity keyed by the estate token — how a client tells the real leader from a forger.", "schema": { "type": "string", "pattern": "^[0-9a-f]{16,64}$" } }
        ],
        "responses": {
          "200": {
            "description": "This node leads",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "role": { "type": "string", "enum": ["leader"] },
                    "host": { "type": "string" },
                    "epoch": { "type": "integer" },
                    "base": { "type": "string" },
                    "watermark": { "type": "integer", "description": "Highest message id served — the freshness tiebreak for election." },
                    "rev": { "type": "string" },
                    "dirty": { "type": "boolean" },
                    "version": { "type": "string" },
                    "draining": { "type": "boolean", "enum": [true], "description": "Present (and true) ONLY while a drain stepdown is in progress: the leader is read-only (writes get 503 draining) and leaves as soon as a replica holds its final snapshot. Absent otherwise. A replica that sees it pulls at once and stands by to take the term." },
                    "proof": { "type": "string", "description": "Only when `nonce` was sent and the bus has a token." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/cc/stepdown": {
      "servers": [{ "url": "/" }],
      "post": {
        "tags": ["control-plane"],
        "summary": "Ask the leader to step down — plain, or loss-free with ?drain=1",
        "description": "Admin: with CC_ADMIN_KEY set, `Authorization: Bearer <admin key>` (or `?admin_key=`); without one, loopback callers only.\n\nPLAIN (no `drain`): the leader leaves at once (writes the .stepdown marker, closes, exits). Used by migrate and by an outranked leader.\n\n`?drain=1` (SQLite backend only): the leader goes READ-ONLY — every non-GET /api request gets `503 {reason:\"draining\"}` + `Retry-After` — and `whoami` reports `draining: true`. It leaves as soon as a replica pulls a FINAL snapshot (a GET /cc/export taken while draining with no write in flight), or at the deadline (CC_DRAIN_MS, default 20000 ms) if none does. If no replica has pulled within the last 40 s there is nobody to drain for, and the request degrades to a PLAIN stepdown (`draining: false`). A PLAIN stepdown that arrives during a drain ends the drain now (`ended_drain: true`); a second `?drain=1` during a drain is a no-op (`draining: true`).",
        "security": [],
        "parameters": [
          { "name": "drain", "in": "query", "required": false, "description": "`1` = the loss-free drain form. Any other value (or none) = plain.", "schema": { "type": "string", "enum": ["1"] } }
        ],
        "responses": {
          "200": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "draining": { "type": "boolean", "description": "true = a drain is (now) in progress; false = plain stepdown, the leader is leaving now." },
                    "deadline_ms": { "type": "integer", "description": "Only on the request that STARTED a drain." },
                    "ended_drain": { "type": "boolean", "description": "Only when a plain stepdown cut an in-progress drain short." }
                  }
                }
              }
            }
          },
          "401": { "description": "CC_ADMIN_KEY is set and the admin key was wrong or missing" },
          "403": { "description": "No CC_ADMIN_KEY and the caller is not on loopback" }
        }
      }
    },
    "/cc/export": {
      "servers": [{ "url": "/" }],
      "get": {
        "tags": ["control-plane"],
        "summary": "Fresh SQLite snapshot for replication/migration (admin, as /cc/stepdown)",
        "security": [],
        "responses": {
          "200": {
            "description": "The snapshot. While the leader is draining the response carries `x-cc-draining: 1` — the replica's cue that the leader is leaving and must be followed closely; a snapshot taken while draining with no write in flight is FINAL and releases the drain.",
            "headers": {
              "x-cc-draining": { "description": "`1` only while a drain stepdown is in progress; absent otherwise.", "schema": { "type": "string", "enum": ["1"] } }
            },
            "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } }
          },
          "401": { "description": "CC_ADMIN_KEY is set and the admin key was wrong or missing" },
          "403": { "description": "No CC_ADMIN_KEY and the caller is not on loopback" },
          "501": { "description": "Not the SQLite backend (no local file to snapshot)" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKeyQuery": { "type": "apiKey", "in": "query", "name": "api_key" }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid input",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "NotFound": {
        "description": "Referenced id or key not found",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/Error" } }
        }
      },
      "Draining": {
        "description": "The leader is in a drain stepdown (POST /cc/stepdown?drain=1) and is read-only: EVERY non-GET /api request is refused, before the handler runs, until it leaves. Nothing was written — retry after Retry-After seconds; by then a successor normally leads (re-discover it). The bundled clients do this automatically.",
        "headers": {
          "Retry-After": { "description": "Seconds to wait before retrying (always 5).", "schema": { "type": "integer", "example": 5 } }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": { "type": "string", "example": "the bus leader is draining for a stepdown; retry shortly" },
                "reason": { "type": "string", "enum": ["draining"] }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": { "error": { "type": "string" } }
      },
      "Instance": {
        "type": "object",
        "properties": {
          "instance_id": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "last_seen": { "type": "string" },
          "status": { "type": "string" },
          "rev": { "type": "string", "nullable": true }
        }
      },
      "Channel": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
